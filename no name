classDiagram
    %% --- Define Groups ---
    direction TB
    namespace CORE_LOGISTICS_GROUP {
        class Customers {
            *👤 customer_id VARCHAR(50) [PK]
            customer_name VARCHAR(100)
            customer_type VARCHAR(50)
            credit_terms_days INT
        }
        class Routes {
            *🗺️ route_id VARCHAR(100) [PK]
            origin_city VARCHAR(100)
            origin_state CHAR(2)
            destination_city VARCHAR(100)
            destination_state CHAR(2)
        }
        class Loads {
            *📦 load_id VARCHAR(100) [PK]
            customer_id VARCHAR(50) [FK]
            route_id VARCHAR(100) [FK]
            weight_lbs INT
            revenue DECIMAL(12,2)
        }
    }

    namespace ASSET_GROUP {
        class Drivers {
            *👤 driver_id VARCHAR(50) [PK]
            first_name VARCHAR(100)
            last_name VARCHAR(100)
            license_number VARCHAR(100)
        }
        class Trucks {
            *🚛 truck_id VARCHAR(100) [PK]
            unit_number VARCHAR(50)
            make VARCHAR(100)
            model VARCHAR(100)
        }
        class Trailers {
            *🧳 trailer_id VARCHAR(100) [PK]
            trailer_number VARCHAR(50)
            trailer_type VARCHAR(50)
            length_feet INT
        }
    }

    namespace OPERATIONAL_GROUP {
        class Trips {
            *🛣️ trip_id VARCHAR(100) [PK]
            load_id VARCHAR(100) [FK]
            truck_id VARCHAR(100) [FK]
            driver_id VARCHAR(50) [FK]
            trailer_id VARCHAR(100) [FK]
        }
        class Delivery_Events {
            *✅ event_id VARCHAR(100) [PK]
            load_id VARCHAR(100) [FK]
            trip_id VARCHAR(100) [FK]
            facility_id VARCHAR(100) [FK]
            scheduled_datetime DATETIME
        }
        class Facilities {
            *🏢 facility_id VARCHAR(100) [PK]
            facility_name VARCHAR(100)
            facility_type VARCHAR(50)
        }
    }

    namespace FLEET_SAFETY_GROUP {
        class Fuel_Purchases {
            *💰 fuel_purchase_id VARCHAR(100) [PK]
            trip_id VARCHAR(100) [FK]
            truck_id VARCHAR(100) [FK]
            driver_id VARCHAR(50) [FK]
            total_cost DECIMAL(12,2)
        }
        class Safety_Incidents {
            *⚠️ incident_id VARCHAR(100) [PK]
            trip_id VARCHAR(100) [FK]
            truck_id VARCHAR(100) [FK]
            driver_id VARCHAR(50) [FK]
            incident_type VARCHAR(100)
        }
        class Maintenance_Records {
            *🔧 maintenance_id VARCHAR(100) [PK]
            truck_id VARCHAR(100) [FK]
            maintenance_type VARCHAR(100)
            total_cost DECIMAL(12,2)
        }
    }

    %% --- Define Relationships (Simplified) ---
    %% One-to-Many connections
    Customers "1" --> "0..*" Loads : customer_id
    Routes "1" --> "0..*" Loads : route_id
    Loads "1" --> "0..*" Trips : load_id
    Loads "1" --> "0..*" Delivery_Events : load_id
    Trips "1" --> "0..*" Delivery_Events : trip_id
    Trips "1" --> "0..*" Fuel_Purchases : trip_id
    Trips "1" --> "0..*" Safety_Incidents : trip_id
    Trucks "1" --> "0..*" Trips : truck_id
    Trucks "1" --> "0..*" Fuel_Purchases : truck_id
    Trucks "1" --> "0..*" Safety_Incidents : truck_id
    Trucks "1" --> "0..*" Maintenance_Records : truck_id
    Drivers "1" --> "0..*" Trips : driver_id
    Drivers "1" --> "0..*" Fuel_Purchases : driver_id
    Drivers "1" --> "0..*" Safety_Incidents : driver_id
    Trailers "1" --> "0..*" Trips : trailer_id
    Facilities "1" --> "0..*" Delivery_Events : facility_id
